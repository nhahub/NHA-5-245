# Run python scripts/init_local_env.py to populate .env with fresh local secrets.
LOCAL_DEMO_PORT=8082
LOCAL_DASHBOARD_PORT=8083
# Docker dashboard upstream, when using the existing n8n container.
SLA_DOCKER_WEBHOOK_URL=http://n8n:5678/webhook/sla-guard
DEMO_CONTROL_TOKEN=
SLA_DB_PASSWORD=
SLA_DATA_DB_PASSWORD=
SLA_DATA_JWT_SECRET=
# Use these values in the separate n8n Header Auth credentials. The dashboard proxy also reads SLA_WEBHOOK_KEY.
SLA_LOCAL_API_JWT=
SLA_WEBHOOK_KEY=
